# instantshit (pad.hosh.it) — environment. Copy to instantshit.env (chmod 600), never commit the real file.
# The defaults below are the hosh.it box values: copying this file unchanged is enough. No secret: the pad
# has no login by design (anyone with the URL can read/replace the text and the file).
# required:

# --- deployment ---
# The only line hosh-deploy changes (one release tag per deploy).
APP_IMAGE='ghcr.io/pazka/instantshit:v0.2.0'
APP_BIND='127.0.0.1:9136'

# --- app ---
# Container port (the image defaults to 80 for the legacy compose; the box standard is 8000).
PORT='8000'
# All state (currentFile, meta.json, currentText.json, tmp/) lives here = the instantshit-data volume.
DATA_DIR='/data'
# Page title (GET /title). Copy the value from the legacy .env if it set one.
TITLE='QuickPaste'
